; Skopíruj ako lupa.ini vedľa Lupa.exe (na L:\_Nastroje\lupa\ je to aj vedľa lupa.db) a uprav.
; lupa.ini sa na git nedáva.
; Skener (aj ikona pri hodinách) číta lupa.ini vedľa programu a potom lupa.ini vedľa databázy –
; ten vedľa databázy má prednosť. Spoločné nastavenia sú teda v L:\_Nastroje\lupa\lupa.ini.

[lupa]
; koreň so zákazkami
root = L:\
; cesta k databáze (relatívna = voči priečinku s programom)
db = lupa.db
; inkrementálny sken: znova prejsť zákazky so zmenou za posledných N dní
recent_days = 14
; odtlačky výkresov (Podobné výkresy): najviac N minút výpočtu na jeden sken, 0 = vypnuté
prints_minutes = 30

; Ktoré priečinky v koreni sú zákazníci. Vzory oddelené čiarkou, * = čokoľvek, ? = jeden znak,
; [0-9] = číslica, veľké/malé písmená nehrajú rolu. Prázdne = všetky priečinky.
; Vynechaní zákazníci sa pri ďalšom skene z databázy odstránia (na disku sa nič nemení).
;   [0-9]*  = začína číslicou (100009-Kuka, 0000000-INDAT)
;   OD*     = staré značenie (OD067)
customers = [0-9]*, OD*
; Vynechať aj tieto (platí navyše ku customers), napr. skryté a koše:
exclude = .*, AI_RecycleBin

; CNC listy (štítok „Listy“ pri zákazke a filter „Moje CNC listy“).
; 1. meno sedí na listy_mena (Word, Excel aj PDF) -> CNC list
; 2. PDF v priečinku (v zákazke), ktorý sedí na listy_priecinky -> CNC list
; 3. Word / Excel s nejasným menom: skener prečíta obsah – cesta R:\priečinok\… alebo aspoň
;    listy_obsah_min slov z listy_obsah -> CNC list (veľké/malé písmená ani diakritika nehrajú rolu)
; PDF, ktoré je CNC listom, sa do štítku „PDF“ (výkres) nepočíta. Vzory ako vyššie, oddelené čiarkou.
listy_mena = *cnc*, *prog*list*, *pgm*list*, *poloha*
listy_priecinky = *cnc*list*
listy_obsah = Programátor:, CESTA:, Názov stroja, Výrobný príkaz:, Artikel:, Výkres:, Program-číslo:
listy_obsah_min = 2
; čítanie obsahu dokumentov: najviac N minút na jeden sken (prvé prejdenie L:\ sa rozloží), 0 = vypnuté
listy_minutes = 10

; Odladené programy (priečinok „odladené“ alebo „Zo stroja“): NC súbor v priečinku s takýmto menom (kdekoľvek pod zákazkou / pozíciou) – filter „Len odladené
; programy“ v Lupe a v hľadaní v obsahu. Vzory oddelené čiarkou, veľké/malé písmená ani diakritika nehrajú rolu.
odladene_priecinky = odlad*, zo*stroja*

; Ikona skenu pri hodinách: bežný sken každých N minút (najmenej 5)
scan_minutes = 60
; Zvonček Nové zákazky: predvolený počet dní (1, 3, 7 alebo 14) – každý si ho v Lupe vie zmeniť
zvoncek_dni = 1
; Kto smie meniť nastavenia v Lupe (koliesko) – mená Windows oddelené čiarkou, prázdne = každý.
; Z ikony skenu (menu Nastavenia…) sa dajú meniť vždy.
spravca =

; Stroje (štítky pri zákazke): skratka = regulárny výraz v texte za „STROJ:“ v hlavičke NC programu.
; Prvé pravidlo, ktoré sedí. Bez tejto sekcie platia predvolené (config.py). Upravuje sa v okne Nastavenia.
; [stroje]
; eVo 80 = DMU\s*(80|85)\s*eVo
; Stroje podľa mena CNC listu (OD…_op20_GMX.xls): skratka = vzor v mene
; [stroje_listy]
; Gamma = gamma
